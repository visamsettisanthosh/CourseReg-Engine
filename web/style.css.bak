/* ==========================================================================
   CampusNexus Modern Course Registration & Timetable Stylesheet
   ========================================================================== */

:root {
    --bg-main: #0f172a;
    --bg-surface: #1e293b;
    --bg-surface-elevated: #283548;
    --bg-input: #0f172a;
    
    --primary: #3b82f6;
    --primary-hover: #2563eb;
    --primary-subtle: rgba(59, 130, 246, 0.15);
    
    --success: #10b981;
    --success-subtle: rgba(16, 185, 129, 0.15);
    --warning: #f59e0b;
    --warning-subtle: rgba(245, 158, 11, 0.15);
    --danger: #ef4444;
    --danger-subtle: rgba(239, 68, 68, 0.15);
    --info: #06b6d4;
    
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    
    --border-color: #334155;
    --border-subtle: #1e293b;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-full: 9999px;
    
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.2);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -2px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -4px rgba(0, 0, 0, 0.4);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

.hidden {
    display: none !important;
}

#login-view.hidden,
#signup-view.hidden,
#main-app-container.hidden,
.login-view-wrapper.hidden {
    display: none !important;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-main);
    color: var(--text-primary);
    line-height: 1.5;
    min-height: 100vh;
}

/* --------------------------------------------------------------------------
   HEADER & BRANDING
   -------------------------------------------------------------------------- */
.app-header {
    background: linear-gradient(180deg, #1e293b 0%, #151e2e 100%);
    border-bottom: 1px solid rgba(59, 130, 246, 0.2);
    padding: 1.1rem 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
}

.header-brand {
    display: flex;
    align-items: center;
}

.brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
}

.brand-title {
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #ffffff;
    line-height: 1.2;
}

.brand-tagline {
    font-size: 0.88rem;
    font-weight: 600;
    color: #60a5fa;
    letter-spacing: -0.01em;
    line-height: 1.3;
}

.brand-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.35;
    margin-top: 0.05rem;
}

.header-controls {
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.semester-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(16, 185, 129, 0.1);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
}

.semester-pill .dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
}

.nav-tabs {
    display: flex;
    background-color: var(--bg-main);
    padding: 0.3rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    gap: 0.25rem;
}

.nav-tab {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
}

.nav-tab:hover {
    color: var(--text-primary);
}

.nav-tab.active {
    background-color: var(--primary);
    color: #ffffff;
    box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3);
}

/* --------------------------------------------------------------------------
   LAYOUT CONTAINER
   -------------------------------------------------------------------------- */
.app-container {
    max-width: 1380px;
    margin: 1.5rem auto;
    padding: 0 1.5rem;
}

.tab-content {
    display: none;
}

.tab-content.active {
    display: block;
    animation: fadeIn 0.25s ease-in-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
}

/* --------------------------------------------------------------------------
   PANELS & CARDS
   -------------------------------------------------------------------------- */
.panel {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    margin-bottom: 1.5rem;
}

.panel-header {
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.panel-header h2 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
}

.section-desc {
    font-size: 0.83rem;
    color: var(--text-secondary);
    margin-top: 0.2rem;
}

.panel-body {
    padding: 1.4rem;
}

.grid-two-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
}

/* --------------------------------------------------------------------------
   PROFILE BAR
   -------------------------------------------------------------------------- */
.profile-card {
    background: linear-gradient(145deg, #1e293b, #1e2942);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
}

.student-select-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 320px;
}

.student-select-box label {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
}

.form-select, .form-input {
    background-color: var(--bg-input);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.9rem;
    font-size: 0.9rem;
    width: 100%;
    outline: none;
    transition: border-color 0.2s;
}

.form-select:focus, .form-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
}

.student-meta-details {
    display: flex;
    align-items: center;
    gap: 1.25rem;
}

.meta-item {
    display: flex;
    flex-direction: column;
}

.meta-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    font-weight: 600;
}

.meta-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
}

/* --------------------------------------------------------------------------
   BADGES & PILLS
   -------------------------------------------------------------------------- */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.badge-success, .badge-low {
    background-color: var(--success-subtle);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.badge-warning, .badge-medium {
    background-color: var(--warning-subtle);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.badge-danger, .badge-high {
    background-color: var(--danger-subtle);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.badge-info {
    background-color: rgba(6, 182, 212, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(6, 182, 212, 0.3);
}

/* --------------------------------------------------------------------------
   LISTS & TABLES
   -------------------------------------------------------------------------- */
.enrollments-list, .transcript-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-height: 240px;
    overflow-y: auto;
}

.enrollment-item, .transcript-item {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.item-left {
    display: flex;
    flex-direction: column;
}

.item-code {
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--primary);
}

.item-name {
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.item-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

/* --------------------------------------------------------------------------
   COURSE CARDS GRID
   -------------------------------------------------------------------------- */
.course-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.25rem;
}

.course-card {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s, border-color 0.2s;
}

.course-card:hover {
    transform: translateY(-2px);
    border-color: #475569;
}

.course-card.status-eligible {
    border-left: 4px solid var(--success);
}

.course-card.status-missing-prereq {
    border-left: 4px solid var(--warning);
}

.course-card.status-clash {
    border-left: 4px solid var(--danger);
}

.course-card.status-enrolled {
    border-left: 4px solid var(--primary);
}

.course-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.5rem;
}

.course-code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
}

.course-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
}

.course-dept {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
}

.slot-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.85rem;
}

.slot-pill {
    background-color: rgba(148, 163, 184, 0.1);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
}

.validation-notice {
    font-size: 0.8rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.notice-eligible {
    background-color: var(--success-subtle);
    color: #34d399;
}

.notice-warning {
    background-color: var(--warning-subtle);
    color: #fbbf24;
}

.notice-danger {
    background-color: var(--danger-subtle);
    color: #f87171;
}

.notice-info {
    background-color: var(--primary-subtle);
    color: #60a5fa;
}

.course-actions {
    display: flex;
    justify-content: flex-end;
}

/* --------------------------------------------------------------------------
   BUTTONS
   -------------------------------------------------------------------------- */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
}

.btn-primary {
    background-color: var(--primary);
    color: #ffffff;
}

.btn-primary:hover {
    background-color: var(--primary-hover);
}

.btn-secondary {
    background-color: #334155;
    color: var(--text-primary);
}

.btn-secondary:hover {
    background-color: #475569;
}

.btn-danger {
    background-color: var(--danger-subtle);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
}

.btn-danger:hover {
    background-color: #ef4444;
    color: #ffffff;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* --------------------------------------------------------------------------
   REGISTRAR DASHBOARD & KPI CARDS
   -------------------------------------------------------------------------- */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.5rem;
}

.kpi-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    box-shadow: var(--shadow-sm);
}

.kpi-icon {
    font-size: 2rem;
    background-color: var(--bg-main);
    padding: 0.75rem;
    border-radius: var(--radius-md);
}

.kpi-info {
    display: flex;
    flex-direction: column;
}

.kpi-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    font-weight: 600;
}

.kpi-value {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
}

.kpi-high-risk .kpi-value {
    color: #f87171;
}

.kpi-med-risk .kpi-value {
    color: #fbbf24;
}

.kpi-low-risk .kpi-value {
    color: #34d399;
}

.kpi-filter-card {
    cursor: pointer;
    user-select: none;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    position: relative;
}

.kpi-filter-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
}

.kpi-filter-card.active-filter {
    border-color: #3b82f6;
    background: linear-gradient(145deg, var(--bg-surface), rgba(59, 130, 246, 0.1));
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.45);
}

.kpi-filter-card.kpi-high-risk.active-filter {
    border-color: #ef4444;
    background: linear-gradient(145deg, var(--bg-surface), rgba(239, 68, 68, 0.12));
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.45);
}

.kpi-filter-card.kpi-med-risk.active-filter {
    border-color: #f59e0b;
    background: linear-gradient(145deg, var(--bg-surface), rgba(245, 158, 11, 0.12));
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.45);
}

.kpi-filter-card.kpi-low-risk.active-filter {
    border-color: #10b981;
    background: linear-gradient(145deg, var(--bg-surface), rgba(16, 185, 129, 0.12));
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.45);
}

.kpi-filter-hint {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-top: 0.25rem;
    display: inline-block;
}

.risk-filter-group {
    display: inline-flex;
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2px;
    gap: 2px;
}

.btn-filter-risk {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.18s ease;
}

.btn-filter-risk:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
}

.btn-filter-risk.active {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(59, 130, 246, 0.4);
}

.btn-filter-risk.risk-btn-high.active {
    background: #ef4444;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(239, 68, 68, 0.4);
}

.btn-filter-risk.risk-btn-medium.active {
    background: #f59e0b;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(245, 158, 11, 0.4);
}

.btn-filter-risk.risk-btn-low.active {
    background: #10b981;
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(16, 185, 129, 0.4);
}

.banner-action-card {
    background: linear-gradient(135deg, #1e293b, #172554);
    border: 1px solid #3b82f6;
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.75rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
}

.banner-text h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #93c5fd;
    margin-bottom: 0.25rem;
}

.banner-text p {
    font-size: 0.85rem;
    color: #cbd5e1;
}

/* --------------------------------------------------------------------------
   DATA TABLES
   -------------------------------------------------------------------------- */
.table-responsive {
    overflow-x: auto;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
}

.data-table th {
    background-color: var(--bg-main);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
}

.data-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-primary);
}

.data-table tr:hover td {
    background-color: rgba(255, 255, 255, 0.02);
}

/* --------------------------------------------------------------------------
   PREREQUISITE DAG VISUALIZER
   -------------------------------------------------------------------------- */
.dag-visual-container {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 1rem 0;
}

.dag-tier {
    background-color: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
}

.dag-tier-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.dag-nodes-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.dag-node-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    min-width: 220px;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s;
}

.dag-node-box:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
}

.node-code {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 0.95rem;
    color: #60a5fa;
}

.node-title {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0.2rem 0;
}

.node-prereq-list {
    font-size: 0.72rem;
    color: var(--text-muted);
    background-color: var(--bg-input);
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-sm);
    margin-top: 0.4rem;
}

.dag-legend {
    display: flex;
    gap: 1.25rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.legend-circle {
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.level-0 { background-color: #10b981; }
.level-1 { background-color: #3b82f6; }
.level-2 { background-color: #8b5cf6; }
.level-3 { background-color: #f59e0b; }

/* --------------------------------------------------------------------------
   MODAL & TOAST
   -------------------------------------------------------------------------- */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.modal-overlay.hidden {
    display: none;
}

.modal-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    width: 90%;
    max-width: 520px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
}

.modal-header {
    padding: 1rem 1.4rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
}

.modal-body {
    padding: 1.4rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.modal-footer {
    padding: 1rem 1.4rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    background-color: var(--bg-main);
}

.toast-container {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    z-index: 2000;
}

.toast {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    font-size: 0.88rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    animation: slideInRight 0.3s ease;
}

.toast-success { border-left: 4px solid var(--success); }
.toast-error { border-left: 4px solid var(--danger); }
.toast-info { border-left: 4px solid var(--primary); }

@keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

/* Responsive tweaks */
@media (max-width: 900px) {
    .grid-two-columns, .kpi-grid, .admin-grid, .docs-grid {
        grid-template-columns: 1fr;
    }
    .app-header {
        flex-direction: column;
        align-items: flex-start;
        padding: 1.1rem 1.5rem;
        gap: 1.1rem;
    }
    .header-brand {
        width: 100%;
    }
    .header-controls {
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 0.8rem;
    }
    .nav-tabs {
        width: 100%;
        overflow-x: auto;
    }
    .nav-tab {
        flex: 1;
        text-align: center;
        white-space: nowrap;
    }
    .profile-card {
        flex-direction: column;
        align-items: stretch;
    }
}

@media (max-width: 600px) {
    .app-header {
        padding: 1rem;
    }
    .brand-title {
        font-size: 1.28rem;
    }
    .brand-tagline {
        font-size: 0.82rem;
    }
    .brand-desc {
        font-size: 0.74rem;
    }
    .semester-pill {
        justify-content: center;
    }
    .nav-tabs {
        flex-wrap: wrap;
    }
}

/* ==========================================================================
   VIVA SCENARIOS BANNER & CONTROLS
   ========================================================================== */
.viva-scenarios-banner {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.95));
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: var(--radius-lg);
    padding: 1.2rem 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

.viva-banner-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border-color);
}

.viva-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1rem;
    color: var(--text-primary);
}

.viva-badge {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.05em;
}

.viva-subtitle {
    font-size: 0.82rem;
    color: var(--text-secondary);
}

.scenarios-button-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
}

.scenario-btn {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
}

.scenario-btn:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
}

.scenario-btn-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.scenario-tag {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    text-transform: uppercase;
}

.scenario-tag.tag-valid { background: rgba(16, 185, 129, 0.2); color: #34d399; }
.scenario-tag.tag-prereq { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
.scenario-tag.tag-clash { background: rgba(239, 68, 68, 0.2); color: #f87171; }
.scenario-tag.tag-high { background: rgba(239, 68, 68, 0.2); color: #f87171; }
.scenario-tag.tag-med { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
.scenario-tag.tag-low { background: rgba(16, 185, 129, 0.2); color: #34d399; }

.scenario-btn-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
}

.scenario-btn-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.3;
}

/* ==========================================================================
   ADMIN MANAGEMENT PANEL
   ========================================================================== */
.admin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
}

.admin-card {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.2rem;
}

.admin-card h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
}

.admin-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
}

.form-group label {
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 500;
}

.form-help {
    font-size: 0.74rem;
    color: var(--text-muted);
    line-height: 1.3;
}

/* ==========================================================================
   VIVA ARCHITECTURE & ALGORITHM CARDS
   ========================================================================== */
.docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 1.5rem;
}

.doc-card {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.doc-card-header {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
}

.doc-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    background: var(--primary-subtle);
    color: var(--primary);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
}

.doc-card-header h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
}

.doc-card-body p {
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
}

.doc-list {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.84rem;
    color: var(--text-secondary);
}

.doc-list li {
    padding-left: 1.2rem;
    position: relative;
    line-height: 1.5;
}

.doc-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: bold;
}

.math-box {
    background-color: var(--bg-main);
    border-left: 3px solid var(--primary);
    padding: 0.6rem 1rem;
    margin: 0.6rem 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.84rem;
    color: #93c5fd;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
}

/* ==========================================================================
   DAG TOPO & CYCLE BANNERS
   ========================================================================== */
.dag-cycle-alert {
    display: none;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid var(--danger);
    color: #f87171;
    padding: 0.8rem 1.2rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    font-weight: 500;
}

.dag-topo-banner {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    padding: 0.75rem 1.2rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
}

.topo-badge {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--primary);
}

.topo-order-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
}

.topo-pill {
    background-color: var(--bg-main);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--text-primary);
}

.topo-arrow {
    color: var(--text-muted);
    font-size: 0.8rem;
}

/* Status colors for DAG visualizer */
.dag-node-box.status-completed {
    border-color: #10b981;
    background: rgba(16, 185, 129, 0.12);
}
.dag-node-box.status-enrolled {
    border-color: #3b82f6;
    background: rgba(59, 130, 246, 0.12);
}
.dag-node-box.status-eligible {
    border-color: #06b6d4;
    background: rgba(6, 182, 212, 0.12);
}
.dag-node-box.status-prereq-required {
    border-color: #f59e0b;
    background: rgba(245, 158, 11, 0.12);
}

/* ==========================================================================
   AUTHENTICATION & LOGIN VIEW STYLES
   ========================================================================== */

.login-view-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 130px);
    padding: 2.5rem 1rem;
    background: radial-gradient(circle at 50% 20%, rgba(30, 58, 138, 0.25) 0%, rgba(15, 23, 42, 0.95) 70%);
}

.login-view-wrapper.hidden {
    display: none !important;
}

.login-card {
    background: #1e293b;
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: var(--radius-lg);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.05);
    width: 100%;
    max-width: 520px;
    padding: 2.5rem 2.25rem;
    animation: fadeInScale 0.3s ease-out;
}

@keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.97); }
    to { opacity: 1; transform: scale(1); }
}

.login-brand {
    text-align: center;
    margin-bottom: 1.75rem;
}

.login-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.025em;
    margin-bottom: 0.35rem;
}

.login-subtitle {
    font-size: 0.92rem;
    font-weight: 600;
    color: #60a5fa;
    margin-bottom: 0.4rem;
}

.login-caption {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
}

/* Role Selector Pills */
.role-selector-pills {
    display: flex;
    background-color: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.3rem;
    margin-bottom: 1.5rem;
    gap: 0.35rem;
}

.role-pill {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.6rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
}

.role-pill:hover {
    color: var(--text-primary);
    background-color: rgba(255, 255, 255, 0.04);
}

.role-pill.active {
    background-color: var(--primary);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
}

.role-pill-icon {
    font-size: 0.95rem;
}

/* Error Banner */
.login-error-banner {
    background-color: rgba(239, 68, 68, 0.12);
    border: 1px solid var(--danger);
    color: #fca5a5;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.login-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.form-label {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-secondary);
}

.input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
}

.input-icon {
    position: absolute;
    left: 0.85rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    pointer-events: none;
    z-index: 2;
}

.input-with-icon .form-input {
    padding-left: 2.6rem;
    width: 100%;
}

.password-input-wrap {
    position: relative;
}

.btn-toggle-pw {
    position: absolute;
    right: 0.75rem;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1rem;
    padding: 0.25rem;
    transition: color 0.2s;
    z-index: 2;
}

.btn-toggle-pw:hover {
    color: var(--text-primary);
}

.login-form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    margin-top: -0.2rem;
}

.remember-me-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-secondary);
    cursor: pointer;
}

.btn-link {
    background: transparent;
    border: none;
    color: #60a5fa;
    font-size: 0.82rem;
    cursor: pointer;
    transition: color 0.2s;
}

.btn-link:hover {
    color: #93c5fd;
    text-decoration: underline;
}

.btn-block {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
}

.btn-lg {
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
}

/* Quick Fill Demo Box */
.demo-accounts-box {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
}

.demo-box-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
    font-size: 0.82rem;
    color: var(--text-primary);
}

.demo-badge {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
}

.demo-accounts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
}

.demo-account-chip {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.65rem 0.75rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
}

.demo-account-chip:hover {
    background: rgba(59, 130, 246, 0.15);
    border-color: var(--primary);
    transform: translateY(-1px);
}

.demo-chip-role {
    font-size: 0.68rem;
    font-weight: 700;
    color: #60a5fa;
    letter-spacing: 0.05em;
    margin-bottom: 0.15rem;
}

.demo-chip-user {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    font-weight: 600;
    color: #ffffff;
}

.demo-chip-name {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* User Session Chip in Header */
.user-session-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-left: 0.5rem;
}

.user-chip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
}

.user-avatar {
    font-size: 1rem;
}

.user-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
}

.user-display-name {
    font-size: 0.82rem;
    font-weight: 600;
    color: #ffffff;
    max-width: 140px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.user-role-badge {
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.35);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
}

.btn-logout-danger {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.35);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-logout-danger:hover {
    background: var(--danger);
    color: #ffffff;
}

/* Access Denied Card */
.access-denied-card {
    background: #1e293b;
    border: 1px solid var(--danger);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 3rem 2rem;
    text-align: center;
    max-width: 580px;
    margin: 3rem auto;
    animation: fadeInScale 0.3s ease-out;
}

.access-denied-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.access-denied-title {
    font-size: 1.6rem;
    color: #f87171;
    font-weight: 700;
    margin-bottom: 0.75rem;
}

.access-denied-msg {
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
}

.access-denied-detail {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
}

/* Admin Dashboard Elements */
.admin-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1.75rem;
}

.admin-subtabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
}

.admin-subtab {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.6rem 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
}

.admin-subtab:hover {
    color: var(--text-primary);
    background: var(--bg-surface-elevated);
}

.admin-subtab.active {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(59, 130, 246, 0.3);
}

.admin-subtab-content {
    display: none;
}

.admin-subtab-content.active {
    display: block;
    animation: fadeIn 0.25s ease-out;
}

.admin-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.admin-section-header h3 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
}

.admin-form-box {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
}

.admin-form-box h4 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: #60a5fa;
}

.admin-form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
}

/* --------------------------------------------------------------------------
   STUDENT PORTAL WELCOME BANNER
   -------------------------------------------------------------------------- */
.student-welcome-banner {
    background: linear-gradient(135deg, rgba(30, 58, 138, 0.4) 0%, rgba(15, 23, 42, 0.75) 100%);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
}

.student-welcome-info .welcome-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #38bdf8;
    display: block;
    margin-bottom: 0.25rem;
}

.student-welcome-info .welcome-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
}

.student-welcome-info .welcome-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
}

.welcome-pill {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    color: var(--text-secondary);
}

.welcome-pill strong {
    color: #67e8f9;
}

/* --------------------------------------------------------------------------
   STUDENT SIGN-UP CARD & PROMPTS
   -------------------------------------------------------------------------- */
.student-signup-prompt {
    display: none !important;
}

.login-provision-notice {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.22);
    border-radius: var(--radius-md);
    text-align: center;
    font-size: 0.83rem;
    color: var(--text-secondary);
    line-height: 1.45;
}

.login-provision-notice .notice-badge {
    color: #60a5fa;
    font-weight: 600;
    display: block;
    margin-bottom: 0.25rem;
}

.btn-link-signup {
    background: none;
    border: none;
    color: #38bdf8;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    font-size: 0.88rem;
    padding: 0;
    transition: color 0.15s ease;
}

.btn-link-signup:hover {
    color: #7dd3fc;
}

.signup-card {
    max-width: 540px;
}

.required-star {
    color: #f87171;
}

.form-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.signup-footer-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.signup-success-box {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    text-align: center;
    margin-bottom: 1.25rem;
    animation: fadeInScale 0.25s ease-out;
}

.success-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: #10b981;
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 700;
    border-radius: 50%;
    margin-bottom: 0.75rem;
}

.signup-success-box h3 {
    font-size: 1.2rem;
    color: #34d399;
    margin-bottom: 0.5rem;
}

.signup-success-box p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.45;
}

.channel-option-card {
    transition: all 0.2s ease;
}

.channel-option-card:hover {
    border-color: #3b82f6 !important;
    background: rgba(59, 130, 246, 0.08) !important;
}
